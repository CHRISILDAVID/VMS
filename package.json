{
  "name": "vms",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "dev:owner": "pnpm --filter @vms/owner start",
    "dev:admin": "pnpm --filter @vms/admin dev",
    "build:admin": "pnpm --filter @vms/admin build",
    "shared:build": "pnpm --filter @vms/shared build",
    "db:types": "supabase gen types typescript --project-id $SUPABASE_PROJECT_ID > packages/shared/src/types/database.ts",
    "clean": "pnpm -r exec rm -rf node_modules dist .expo",
    "typecheck": "pnpm -r typecheck"
  },
  "engines": {
    "node": ">=20",
    "pnpm": ">=9"
  },
  "pnpm": {
    "minimumReleaseAge": 0,
    "minimumReleaseAgeExclude": ["*", "undici"]
  }
}
