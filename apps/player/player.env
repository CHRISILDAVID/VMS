# Environment variables for ShuttleHub Player App
# Copy this file to .env and fill in your Supabase credentials
# (Same Supabase project as Owner App — different table)

EXPO_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxx
EXPO_PUBLIC_RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
EXPO_PUBLIC_RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxx